# tests/gates/aegis-clippy.gate
# Mirrors hosted: ci.yml 'Cargo Clippy Invariant': cargo clippy --all-targets -- -D warnings
gate: AEGIS-CLIPPY
manifest_version: 2
owner: aegis-runtime
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - src/
  - tests/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["clippy"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine
