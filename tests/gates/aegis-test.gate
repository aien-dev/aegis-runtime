# tests/gates/aegis-test.gate
# Mirrors hosted: ci.yml 'Run Workspace Unit and Integration Tests': cargo test --verbose -- --test-threads=1 (hosted job 110 s total)
gate: AEGIS-TEST
manifest_version: 2
owner: aegis-runtime
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - src/
  - tests/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["test"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
